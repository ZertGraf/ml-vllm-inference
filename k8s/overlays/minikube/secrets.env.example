# Copy to secrets.env (git-ignored) or run scripts/make-secrets.sh.
# HF_TOKEN: Hugging Face access token. Leave EMPTY for public models such as
#           Qwen/Qwen2.5-0.5B-Instruct; required for gated/private repos.
# VLLM_API_KEY: Bearer token API clients must send. Use a long random value:
#           python -c "import secrets; print(secrets.token_urlsafe(32))"
HF_TOKEN=
VLLM_API_KEY=change-me-to-a-long-random-value
